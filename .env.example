# HealRAG Configuration

# LLM Credentials (Provide either OpenRouter or OpenAI key)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=

# Embedding Model (OpenAI text-embedding-3-small or local sentence-transformers/all-MiniLM-L6-v2)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage & Retrieval Settings
CHROMA_PERSIST_DIR=./data/chroma
TOP_K=4
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Self-Healing & Quality Thresholds
MAX_RETRIES=2
RELEVANCE_THRESHOLD=0.5
GROUNDING_THRESHOLD=0.7
RAGAS_THRESHOLD=0.7
